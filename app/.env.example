# Telegram Bot Integration
# 1. Create a bot via @BotFather on Telegram and copy API Token
VITE_TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# 2. Get your Chat ID or Channel ID (e.g. from @userinfobot or channel ID starting with -100)
VITE_TELEGRAM_CHAT_ID="-1001234567890"

# Contact Email Address (For website display & notification target)
VITE_CONTACT_EMAIL="contact@av-studio.digital"

# Optional Email Endpoint or Webhook (Formspree, Resend, or custom API route)
VITE_EMAIL_ENDPOINT="https://formspree.io/f/your_form_id"

# OpenRouter AI Integration
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="nvidia/nemotron-3-nano-30b-a3b:free"
